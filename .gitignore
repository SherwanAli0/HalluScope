__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/

# Regenerable / heavy stage outputs are NOT tracked:
#   data/processed/      regenerated by data/fetch_datasets.py (seconds, offline)
#   generation/outputs/  per-token logit data (~37 MB) - regenerate on GPU or get
#                        the complete zip / Drive folder (see README "Data")
#   entropy/outputs/     regenerated from generation outputs (seconds)
data/processed/
generation/outputs/
entropy/outputs/

# evaluation/outputs/ IS tracked: it is the labeled per-sentence data behind
# every table, and lets anyone re-aggregate the results without a GPU.

# raw colab download zips (backup copies live outside the repo)
results/*.zip
